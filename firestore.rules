rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /houses/{houseId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerId', 'title', 'description', 'photoUrl', 'photoUrls', 'createdAt', 'updatedAt',
          'prefecture', 'city', 'town', 'rent', 'areaSize'
        ])
        && request.resource.data.prefecture is string
        && request.resource.data.prefecture.size() <= 30
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 120
        && request.resource.data.town is string
        && request.resource.data.town.size() <= 200
        && request.resource.data.rent is string
        && request.resource.data.rent.size() <= 50
        && request.resource.data.areaSize is string
        && request.resource.data.areaSize.size() <= 50
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() > 0
            && request.resource.data.photoUrl.size() < 2048
            && request.resource.data.photoUrl.matches('https://.*')))
        && (!('photoUrls' in request.resource.data)
          || (request.resource.data.photoUrls is list
            && request.resource.data.photoUrls.size() <= 20));

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.keys().hasOnly([
          'ownerId', 'title', 'description', 'photoUrl', 'photoUrls', 'createdAt', 'updatedAt',
          'prefecture', 'city', 'town', 'rent', 'areaSize'
        ])
        && request.resource.data.prefecture is string
        && request.resource.data.prefecture.size() <= 30
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 120
        && request.resource.data.town is string
        && request.resource.data.town.size() <= 200
        && request.resource.data.rent is string
        && request.resource.data.rent.size() <= 50
        && request.resource.data.areaSize is string
        && request.resource.data.areaSize.size() <= 50
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() > 0
            && request.resource.data.photoUrl.size() < 2048
            && request.resource.data.photoUrl.matches('https://.*')))
        && (!('photoUrls' in request.resource.data)
          || (request.resource.data.photoUrls is list
            && request.resource.data.photoUrls.size() <= 20));

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /inquiries/{inquiryId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }
  }
}
