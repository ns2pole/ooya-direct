rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function houseDoc(houseId) {
      return get(/databases/$(database)/documents/houses/$(houseId));
    }

    function isHouseOwner(houseId) {
      return request.auth != null
        && houseDoc(houseId).data.ownerId == request.auth.uid;
    }

    function validStorageUrl(field) {
      return field is string
        && field.size() > 0
        && field.size() < 8192
        && field.matches('https://.*');
    }

    function validCoverPhotoUrl() {
      return !('coverPhotoUrl' in request.resource.data)
        || validStorageUrl(request.resource.data.coverPhotoUrl);
    }

    function validLegacyPhotoUrl() {
      return !('photoUrl' in request.resource.data)
        || validStorageUrl(request.resource.data.photoUrl);
    }

    function validLegacyPhotoUrls() {
      return !('photoUrls' in request.resource.data)
        || (request.resource.data.photoUrls is list
          && request.resource.data.photoUrls.size() <= 20);
    }

    function validHouseFields() {
      return request.resource.data.keys().hasOnly([
          'ownerId', 'title', 'description', 'coverPhotoUrl',
          'photoUrl', 'photoUrls',
          'createdAt', 'updatedAt',
          'prefecture', 'city', 'town', 'rent', 'areaSize'
        ])
        && request.resource.data.prefecture is string
        && request.resource.data.prefecture.size() <= 30
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 120
        && request.resource.data.town is string
        && request.resource.data.town.size() <= 200
        && request.resource.data.rent is string
        && request.resource.data.rent.size() <= 50
        && request.resource.data.areaSize is string
        && request.resource.data.areaSize.size() <= 50
        && validCoverPhotoUrl()
        && validLegacyPhotoUrl()
        && validLegacyPhotoUrls();
    }

    function validPhotoDoc() {
      return request.resource.data.keys().hasOnly([
          'url', 'order', 'createdAt'
        ])
        && validStorageUrl(request.resource.data.url)
        && request.resource.data.order is number
        && request.resource.data.order >= 0
        && request.resource.data.order <= 19;
    }

    match /houses/{houseId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && validHouseFields();

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validHouseFields();

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /photos/{photoId} {
        allow read: if true;

        allow create: if isHouseOwner(houseId)
          && validPhotoDoc();

        allow update: if isHouseOwner(houseId)
          && validPhotoDoc();

        allow delete: if isHouseOwner(houseId);
      }

      match /inquiries/{inquiryId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }
  }
}
