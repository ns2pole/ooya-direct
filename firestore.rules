rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function houseDoc(houseId) {
      return get(/databases/$(database)/documents/houses/$(houseId));
    }

    function isHouseOwner(houseId) {
      return request.auth != null
        && houseDoc(houseId).data.ownerId == request.auth.uid;
    }

    function validStorageUrl(field) {
      return field is string
        && field.size() > 0
        && field.size() < 8192
        && field.matches('https://.*');
    }

    function validCoverPhotoUrl() {
      return !('coverPhotoUrl' in request.resource.data)
        || validStorageUrl(request.resource.data.coverPhotoUrl);
    }

    function validLegacyPhotoUrl() {
      return !('photoUrl' in request.resource.data)
        || validStorageUrl(request.resource.data.photoUrl);
    }

    function validLegacyPhotoUrls() {
      return !('photoUrls' in request.resource.data)
        || (request.resource.data.photoUrls is list
          && request.resource.data.photoUrls.size() <= 20);
    }

    function validHouseFields() {
      return request.resource.data.keys().hasOnly([
          'ownerId', 'title', 'description', 'coverPhotoUrl',
          'photoUrl', 'photoUrls',
          'createdAt', 'updatedAt',
          'prefecture', 'city', 'town',
          'rent', 'managementFee', 'genre', 'depositKeyMoney',
          'areaSize', 'floorArea', 'floors', 'buildingAge',
          'referenceUrl',
          'landlordId', 'sourceId', 'fromSync', 'hidden'
        ])
        && request.resource.data.prefecture is string
        && request.resource.data.prefecture.size() <= 30
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 120
        && request.resource.data.town is string
        && request.resource.data.town.size() <= 200
        && request.resource.data.rent is string
        && request.resource.data.rent.size() <= 50
        && request.resource.data.managementFee is string
        && request.resource.data.managementFee.size() <= 50
        && request.resource.data.genre is string
        && request.resource.data.genre.size() <= 30
        && request.resource.data.depositKeyMoney is string
        && request.resource.data.depositKeyMoney.size() <= 50
        && request.resource.data.areaSize is string
        && request.resource.data.areaSize.size() <= 50
        && request.resource.data.floorArea is string
        && request.resource.data.floorArea.size() <= 50
        && request.resource.data.floors is string
        && request.resource.data.floors.size() <= 50
        && request.resource.data.buildingAge is string
        && request.resource.data.buildingAge.size() <= 50
        && request.resource.data.referenceUrl is string
        && request.resource.data.referenceUrl.size() <= 2048
        && validCoverPhotoUrl()
        && validLegacyPhotoUrl()
        && validLegacyPhotoUrls()
        && (!('landlordId' in request.resource.data)
          || (request.resource.data.landlordId is string
            && request.resource.data.landlordId.size() <= 128))
        && (!('sourceId' in request.resource.data)
          || (request.resource.data.sourceId is string
            && request.resource.data.sourceId.size() <= 128))
        && (!('fromSync' in request.resource.data)
          || request.resource.data.fromSync is bool)
        && (!('hidden' in request.resource.data)
          || request.resource.data.hidden is bool);
    }

    function manualHouseCreate() {
      return request.resource.data.landlordId is string
        && request.resource.data.landlordId.size() > 0
        && request.resource.data.sourceId == ''
        && request.resource.data.fromSync == false
        && request.resource.data.hidden == false;
    }

    function validPhotoDoc() {
      return request.resource.data.keys().hasOnly([
          'url', 'order', 'createdAt'
        ])
        && validStorageUrl(request.resource.data.url)
        && request.resource.data.order is number
        && request.resource.data.order >= 0
        && request.resource.data.order <= 19;
    }

    match /landlordProfiles/{ownerId} {
      allow read: if request.auth != null && request.auth.uid == ownerId;
      allow create, update, delete: if false;
    }

    match /lineLinkCodes/{code} {
      allow read, write: if false;
    }

    match /houses/{houseId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && validHouseFields()
        && manualHouseCreate();

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validHouseFields()
        && (
          resource.data.fromSync == true
            ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'updatedAt'])
            : request.resource.data.fromSync != true
        );

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /photos/{photoId} {
        allow read: if true;

        allow create: if isHouseOwner(houseId)
          && validPhotoDoc();

        allow update: if isHouseOwner(houseId)
          && validPhotoDoc();

        allow delete: if isHouseOwner(houseId);
      }

      match /inquiries/{inquiryId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
    }

    match /landlords/{landlordId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']);

      allow delete: if false;
    }

    match /portalSources/{sourceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if request.auth != null && docId == "jimoty";
      allow write: if false;
    }
  }
}
