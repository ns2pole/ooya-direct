rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /houses/{houseId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.exists(/databases/(default)/documents/houses/$(houseId))
        && firestore.get(/databases/(default)/documents/houses/$(houseId)).data.ownerId
          == request.auth.uid;
    }
  }
}
